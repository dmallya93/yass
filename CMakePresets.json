{
    "version": 3,
    "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_CLANG_TIDY": "ON",
                "ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_CLANG_TIDY": "ON",
                "ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC Debug",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "g++",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC Release",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/gcc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENABLE_SANITIZERS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {"name": "default", "configurePreset": "default"},
        {"name": "clang-debug", "configurePreset": "clang-debug"},
        {"name": "clang-release", "configurePreset": "clang-release"},
        {"name": "gcc-debug", "configurePreset": "gcc-debug"},
        {"name": "gcc-release", "configurePreset": "gcc-release"}
    ],
    "testPresets": [
        {"name": "default", "configurePreset": "default"},
        {"name": "clang-debug", "configurePreset": "clang-debug"},
        {"name": "clang-release", "configurePreset": "clang-release"},
        {"name": "gcc-debug", "configurePreset": "gcc-debug"},
        {"name": "gcc-release", "configurePreset": "gcc-release"}
    ]
}
